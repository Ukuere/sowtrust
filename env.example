# ─────────────────────────────────────────────────────────
# Sowtrust — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Africa's Talking credentials
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here

# Paystack credentials (test mode first — sk_test_/pk_test_ — never
# switch to sk_live_/pk_live_ until you've fully tested the flow)
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_ENV=production
FLASK_PORT=5000

# Database (absolute path recommended for production)
DATABASE_PATH=sowtrust.db

# Escrow settings
SERVICE_FEE_PERCENT=2.5
ESCROW_EXPIRY_HOURS=72
USSD_SESSION_TTL_SECONDS=120
PAYMENT_PENDING_TIMEOUT_MINUTES=60

# Admin dashboard password
DASHBOARD_ADMIN_PASSWORD=changeme
