# ─────────────────────────────────────────────────────────
# AgriHub Global — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Africa's Talking credentials
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_ENV=production
FLASK_PORT=5000
PUBLIC_BASE_URL=https://your-domain.example
ENFORCE_PRODUCTION_CONFIG=0
RATE_LIMIT_PER_MINUTE=120

# Database (absolute path recommended for production)
DATABASE_PATH=agrihub.db
UPLOAD_FOLDER=uploads
STORAGE_BACKEND=local

# Escrow settings
SERVICE_FEE_PERCENT=2.5
ESCROW_EXPIRY_HOURS=72
USSD_SESSION_TTL_SECONDS=120

# Admin dashboard password
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=changeme

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Buyer payment timeout
PAYMENT_PENDING_TIMEOUT_MINUTES=60
