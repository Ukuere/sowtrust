# ─────────────────────────────────────────────────────────
# SowTrust - Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# Africa's Talking credentials
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here
USSD_MODE=SANDBOX
USSD_PUBLIC_CODE=

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_string
FLASK_ENV=production
FLASK_PORT=5000
PUBLIC_BASE_URL=https://your-domain.example
CANONICAL_HOST=sowtrust.com
SESSION_COOKIE_DOMAIN=
SESSION_LIFETIME_HOURS=8
ENFORCE_PRODUCTION_CONFIG=0
RATE_LIMIT_PER_MINUTE=120

# Database (absolute path recommended for production)
DATABASE_PATH=/app/data/sowtrust.db
UPLOAD_FOLDER=uploads
STORAGE_BACKEND=local
# For private Cloudflare R2, AWS S3, or another S3-compatible service:
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PREFIX=sowtrust

# Phone OTP activation
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Escrow settings
SERVICE_FEE_PERCENT=2.5
ESCROW_EXPIRY_HOURS=72
USSD_SESSION_TTL_SECONDS=120

# Admin dashboard password
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=changeme
DASHBOARD_API_TOKEN=replace_with_a_long_random_shared_token
BACKEND_API_URL=https://sowtrust.com
CEO_CONSOLE_URL=https://ops.sowtrust.com

# Exception monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# SQLite backups (run scripts/backup_db.py from a Railway cron service)
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION_COUNT=14
BACKUP_TO_OBJECT_STORAGE=0

# Public support details
SUPPORT_EMAIL=support@sowtrust.com
SUPPORT_PHONE=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Buyer payment timeout
PAYMENT_PENDING_TIMEOUT_MINUTES=60
